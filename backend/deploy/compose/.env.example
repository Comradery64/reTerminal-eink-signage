# Copy to .env, fill in real values, then `chmod 0600 .env`. Never commit the filled-in version.
# Loaded by the `broker` service via env_file: .env in docker-compose.yml.

# Session-signing sanity check for the /admin, /manager, /dashboard logins (see docs/SECURITY.md).
# Required (>=32 bytes) once any user is configured in config/config.yaml. Generate with e.g.
# `openssl rand -base64 32`.
SESSION_SECRET=

# Slack incoming webhook for the building-manager low-battery alert. Omit or leave empty to log
# alerts instead of pushing them.
ALERT_WEBHOOK_URL=

# WPA2 pre-shared key for the fleet Wi-Fi, written into each display's NVS by the /admin
# "Add a device" wizard (config `fleet.wifi_psk`). Omit or leave empty to disable the wizard and
# provision devices with tools/provision_device.sh instead.
MD_WIFI_PSK=

# Only needed with `docker compose --profile google up` (see docs/GOOGLE-AUTH.md). Must match what
# was passed to `gcloud iam workload-identity-pools providers create-oidc` when the provider was
# created — WIFTOKEN_ISSUER is --issuer-uri, WIFTOKEN_AUDIENCE is the provider's full resource name.
WIFTOKEN_ISSUER=https://displays.example.internal/oidc
WIFTOKEN_AUDIENCE=//iam.googleapis.com/projects/000000000000/locations/global/workloadIdentityPools/displays-pool/providers/onprem
