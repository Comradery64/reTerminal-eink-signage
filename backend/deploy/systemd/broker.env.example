# Copy to /etc/meeting-displays/broker.env, fill in real values, then:
#   chmod 0600 /etc/meeting-displays/broker.env
#   chown meeting-displays:meeting-displays /etc/meeting-displays/broker.env
#
# Names only below — never commit real values (see this repo's global secrets policy). Both units
# (meeting-displays-broker.service, wiftoken.service) load this file via EnvironmentFile=- (the
# leading "-" makes it optional, so a fresh install without secrets configured yet still starts).

# Session-signing sanity check for the /admin, /manager, /dashboard logins (see docs/SECURITY.md
# and internal/auth) — required (>=32 bytes) once any user is configured. Generate with e.g.
# `openssl rand -base64 32`.
SESSION_SECRET=

# Slack incoming webhook for the building-manager low-battery alert (internal/notify). Omit or
# leave empty to log alerts instead of pushing them.
ALERT_WEBHOOK_URL=

# WPA2 pre-shared key for the fleet Wi-Fi, written into each display's NVS by the /admin
# "Add a device" wizard (config `fleet.wifi_psk`). Omit or leave empty to disable the wizard and
# provision devices with tools/provision_device.sh instead.
MD_WIFI_PSK=
