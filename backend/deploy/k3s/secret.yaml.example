# Google auth is KEYLESS (Workload Identity Federation) — there is NO service-account key secret.
# This secret holds the optional Slack alert webhook, the fleet Wi-Fi PSK, and the session-signing
# sanity check for /admin, /manager, /dashboard logins:
#   kubectl -n meeting-displays create secret generic broker-secrets \
#     --from-literal=alert-webhook-url='https://hooks.slack.com/services/T000/B000/XXXX' \
#     --from-literal=session-secret="$(openssl rand -base64 32)" \
#     --from-literal=wifi-psk='<the fleet Wi-Fi PSK>'
#
# The broker reads these as ALERT_WEBHOOK_URL / SESSION_SECRET / MD_WIFI_PSK env vars (see
# broker.yaml). Omit alert-webhook-url to log battery alerts instead of pushing them to Slack;
# omit wifi-psk to disable the /admin "Add a device" wizard and keep provisioning on
# tools/provision_device.sh.
#
# wifi-psk is a FLEET-WIDE secret — one leak affects every display, unlike a per-device token — so
# it never reaches a browser: the broker builds each NVS image server-side (internal/nvs) and
# returns only the opaque partition bytes bound for that unit's flash.
#
# Login accounts themselves (username, password hash, role) are NOT here — they live in the
# ConfigMap's `users:` list (see broker.yaml.example), the same way Room.token_sha256 does, and
# are managed from /admin's Access panel after the first bootstrap admin account.
#
# (TLS for devices is separate: the `broker-tls` secret holds the Ingress leaf cert+key signed by
#  your internal CA — created out of band, not here.)
apiVersion: v1
kind: Secret
metadata:
  name: broker-secrets
  namespace: meeting-displays
type: Opaque
stringData:
  alert-webhook-url: "https://hooks.slack.com/services/REPLACE"
  session-secret: "REPLACE_WITH_32_PLUS_BYTE_RANDOM_STRING"
  wifi-psk: "REPLACE_WITH_FLEET_WIFI_PSK"
