# Initial config for the broker on k3s (Tier 3). FIRST INSTALL ONLY: copy to config.seed.yaml, replace
# every placeholder, then create the ConfigMap once:
#   kubectl -n meeting-displays create configmap broker-config --from-file=config.yaml=config.seed.yaml
# `create` refuses to overwrite an existing ConfigMap. Never `kubectl apply` or re-create a copy of
# this over a running broker: the live ConfigMap is edited by the broker itself from /admin (users,
# password hashes, 2FA secrets, rooms, locations, push subscriptions), so a file from git replaces
# all of it. After install, change config in /admin, or with a backed-up patch of data["config.yaml"].
listen: ":8080"
poll_interval: "2m"
wake:
  business_hours_seconds: 600
  off_hours_seconds: 3600
  business_start_hour: 7
  business_end_hour: 20
  timezone: "America/New_York"   # REPLACE with your own IANA timezone
  # Optional: once-daily forced full repaint (anti-ghosting) at this off-hours local hour.
  # Omit to disable. See backend/config.example.yaml for the full explanation.
  forced_refresh_hour: 3
render:
  width: 800
  height: 480
  dither: true
provider: "google"
google:
  # Keyless: external-account (WIF) cred config that references the projected k8s token.
  credentials_file: "/etc/gcp/cred-config.json"
  # "free_busy" (default) or "titles". "titles" needs the calendar.events.readonly scope AND
  # each room shared as reader (not freeBusyReader), and puts real meeting titles on a public
  # wall panel. See config.example.yaml for the full trade-off. Restart required to change.
  detail_level: "free_busy"
alerts:
  low_battery_pct: 45
  clear_pct: 55
  min_renotify: "24h"
  # Empty = log alerts instead of pushing them. To enable Slack, put alert-webhook-url in
  # broker-secrets AND change this to "${ALERT_WEBHOOK_URL}". Referencing a ${VAR} whose key
  # you haven't created is a startup error — the Deployment marks it optional, so the pod
  # would otherwise crashloop on a value you were told you could omit.
  webhook_url: ""
  stale_after: "1h"   # feeds /api/v1/status; keep in sync with DisplayStale's `3600` in alerts.yaml
# Fleet-wide Wi-Fi for the /admin "Add a device" provisioning wizard. The PSK stays a ${VAR}
# reference so it lives in broker-secrets, not in this ConfigMap — MarshalForPersist restores
# the reference before any admin save writes the config back, so the expanded value never
# leaks into the ConfigMap either.
fleet:
  wifi_ssid: "REPLACE_WITH_YOUR_SSID"
  # Leave empty to disable the "Add a device" wizard. To enable it, add the wifi-psk key to
  # broker-secrets AND change this to "${MD_WIFI_PSK}" — see the note on webhook_url above.
  wifi_psk: ""
# Spelled out explicitly (rather than left as the default "auto") so `kubectl get configmap
# broker-config -o yaml` shows the real, resolved behavior at a glance instead of requiring a
# reader to know k3s auto-detection rules. These are the SAME values "auto" already resolves to
# in-cluster (given the ServiceAccount/Role/RoleBinding below) — this block changes nothing.
# If this ever fails with a 403, see docs/DEPLOY-TIERS.md's Tier 3 triage checklist before
# assuming the broker code is at fault; the most common cause is the ServiceAccount below not
# actually being wired to the pod spec.
config_persistence:
  mode: configmap
  configmap:
    namespace: meeting-displays
    name: broker-config
    key: config.yaml
auth:
  # session_secret is a deploy-time sanity check (not used for signing — sessions are
  # server-side, see internal/auth) that a real secrets bundle was provisioned before login is
  # enabled. Required (>=32 bytes) if the users list below is non-empty.
  session_secret: "${SESSION_SECRET}"
# /admin, /manager, and /dashboard login accounts. Only this first bootstrap admin needs
# to be hand-edited here — grant/edit/revoke everyone else from /admin's Access panel from now
# on (config.WithUser/WithoutUser persist straight back to this ConfigMap, same as room
# edits). role is "admin" (full config access), "manager" (status + wake-mode control), or
# "viewer" (status only, read-only). At least one admin must always exist.
users:   # REPLACE with your own first admin account
  - username: "admin"
    password_sha256: "REPLACE_WITH_SHA256_OF_ADMIN_PASSWORD"
    role: "admin"
rooms:   # REPLACE with your own rooms; token_sha256 = hash only, generated by provision_all.sh
  - device_id: "rt-example-a"
    name: "Aspen"
    room: "aspen@example.com"
    token_sha256: "REPLACE_WITH_SHA256_OF_DEVICE_TOKEN"
  - device_id: "rt-example-b"
    name: "Birch"
    room: "birch@example.com"
    token_sha256: "REPLACE_WITH_SHA256_OF_DEVICE_TOKEN"
